<UserControl x:Class="WinSystem.Views.UserView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <DataTemplate x:Key="StatusTagTemplate">
            <Border Style="{StaticResource StatusTag}"
                    Background="{Binding StatusText, Converter={StaticResource StatusToTag}, ConverterParameter=background}">
                <TextBlock Text="{Binding StatusText}" FontSize="12" FontWeight="SemiBold"
                           Foreground="{Binding StatusText, Converter={StaticResource StatusToTag}}"/>
            </Border>
        </DataTemplate>

        <!-- 行内操作按钮 -->
        <Style x:Key="RowActionButton" TargetType="{x:Type Button}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="{StaticResource SmallRadius}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#EAF0FB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RowDangerButton" TargetType="{x:Type Button}" BasedOn="{StaticResource RowActionButton}">
            <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Bd" Background="Transparent"
                                CornerRadius="{StaticResource SmallRadius}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FDECEC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="26,22,26,26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 页头 -->
        <Grid Grid.Row="0">
            <StackPanel>
                <TextBlock Text="用户管理" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="管理系统中的所有账号、角色与启用状态" Style="{StaticResource PageSubtitle}"/>
            </StackPanel>
            <Button Content="＋  新增用户" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right"
                    VerticalAlignment="Center" Command="{Binding AddCommand}"/>
        </Grid>

        <!-- 数据卡 -->
        <Border Grid.Row="1" Margin="0,18,0,16" Padding="0" Background="Transparent" BorderThickness="0">
            <Grid>
                <!-- 查询条件 -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <TextBlock Text="姓名" FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center"/>
                    <TextBox Style="{StaticResource SearchBox}" Width="140" Margin="6,0,16,0"
                             Text="{Binding SearchName, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="账号" FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center"/>
                    <TextBox Style="{StaticResource SearchBox}" Width="140" Margin="6,0,0,0"
                             Text="{Binding SearchUsername, UpdateSourceTrigger=PropertyChanged}"/>
                    <Button Content="查询" Style="{StaticResource PrimaryButton}" Margin="16,0,0,0"
                            Command="{Binding SearchCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 表格 -->
        <Grid Grid.Row="2">
            <Border Style="{StaticResource Card}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DataGrid Grid.Row="0" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="行号" Binding="{Binding Index}" Width="60"/>
                        <DataGridTextColumn Header="账号ID" Binding="{Binding Id}" Width="90"/>
                        <DataGridTextColumn Header="登录名" Binding="{Binding Username}" Width="120"/>
                        <DataGridTextColumn Header="姓名" Binding="{Binding Name}" Width="100"/>
                        <DataGridTextColumn Header="职位" Binding="{Binding Position}" Width="130"/>
                        <DataGridTextColumn Header="邮箱" Binding="{Binding Email}" Width="*"/>
                        <DataGridTextColumn Header="手机号" Binding="{Binding Phone}" Width="125"/>
                        <DataGridTextColumn Header="登录次数" Binding="{Binding LoginCount}" Width="85"/>
                        <DataGridTextColumn Header="最后登录" Binding="{Binding LastLoginAt, StringFormat=yyyy-MM-dd HH:mm}" Width="150"/>
                        <DataGridTemplateColumn Header="状态" Width="90" CellTemplate="{StaticResource StatusTagTemplate}"/>
                        <DataGridTemplateColumn Header="操作" Width="215">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2">
                                        <Button Content="编辑" Style="{StaticResource RowActionButton}"
                                                Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                                                CommandParameter="{Binding}"/>
                                        <Button Content="重置密码" Style="{StaticResource RowActionButton}" Margin="8,0,0,0"
                                                Command="{Binding DataContext.ResetPasswordCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                                                CommandParameter="{Binding}"/>
                                        <Button Content="删除" Style="{StaticResource RowDangerButton}" Margin="8,0,0,0"
                                                Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                                                CommandParameter="{Binding}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- 分页栏 -->
                <Border Grid.Row="1" Background="#FAFBFE" BorderBrush="{StaticResource DividerBrush}"
                        BorderThickness="0,1,0,0" Padding="16,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- 每页条数 -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="每页" FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center"/>
                            <ComboBox Width="70" Margin="6,0" SelectedItem="{Binding PageSize}"
                                      ItemsSource="{Binding PageSizeOptions}"
                                      Style="{StaticResource ComboBoxStyle}"
                                      ItemContainerStyle="{StaticResource ComboBoxItemStyle}" MinHeight="28"/>
                            <TextBlock Text="条" FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- 分页信息 -->
                        <TextBlock Grid.Column="1" Text="{Binding PageInfo}" FontSize="12.5"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>

                        <!-- 分页按钮 -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="«" Style="{StaticResource PageButton}" Command="{Binding FirstPageCommand}" ToolTip="首页"/>
                            <Button Content="‹" Style="{StaticResource PageButton}" Margin="6,0,0,0" Command="{Binding PrevPageCommand}" ToolTip="上一页"/>
                            <TextBlock Text="{Binding PageIndex}" FontSize="13" FontWeight="SemiBold" Margin="12,0"
                                       Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="/" FontSize="12" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding TotalPages}" FontSize="13" Margin="6,0,12,0"
                                       Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                            <Button Content="›" Style="{StaticResource PageButton}" Command="{Binding NextPageCommand}" ToolTip="下一页"/>
                            <Button Content="»" Style="{StaticResource PageButton}" Margin="6,0,0,0" Command="{Binding LastPageCommand}" ToolTip="末页"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
            </Border>

            <!-- 加载动画层 -->
            <Border Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"
                    Background="#55FFFFFF" CornerRadius="{StaticResource LargeRadius}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ProgressBar IsIndeterminate="True" Width="160" Height="5"/>
                    <TextBlock Text="正在加载数据…" FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,14,0,0" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>