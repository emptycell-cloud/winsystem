<Window x:Class="WinSystem.Views.ConfigEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:WinSystem.ViewModels"
        Title="系统参数编辑" Width="600" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" FontFamily="{StaticResource DefaultFont}"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Border Background="White" CornerRadius="14" Padding="26" Margin="10"
            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="4" Opacity="0.20" Direction="270"/>
        </Border.Effect>
        <StackPanel>
            <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimaryBrush}"/>
            <Rectangle Height="1" Margin="-12,14,-12,0" Fill="{StaticResource DividerBrush}"/>

            <Grid Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 第1行：名称 / 键 -->
                <StackPanel Grid.Row="0" Grid.Column="0">
                    <TextBlock Text="参数名称" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding ConfigName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextField}"/>
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="2">
                    <TextBlock Text="参数键" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding ConfigKey, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextField}"
                             ToolTip="如 site.name、login.maxRetries"/>
                </StackPanel>

                <!-- 第2行：类型 / 来源 -->
                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,14,0,0">
                    <TextBlock Text="参数类型" Style="{StaticResource FieldLabel}"/>
                    <ComboBox ItemsSource="{x:Static vm:ConfigEditorViewModel.TypeOptions}"
                              SelectedItem="{Binding ConfigType}" Style="{StaticResource ComboBoxStyle}"
                              ItemContainerStyle="{StaticResource ComboBoxItemStyle}" MinHeight="36"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,14,0,0"
                            Visibility="{Binding IsSystemBuiltIn, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="来源" Style="{StaticResource FieldLabel}"/>
                    <Border Background="#F1F2F4" CornerRadius="{StaticResource SmallRadius}" Padding="12,8">
                        <TextBlock Text="系统内置" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </Border>
                </StackPanel>

                <!-- 第3行：值（整行多行） -->
                <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,14,0,0">
                    <TextBlock Text="参数值" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding ConfigValue, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextField}"
                             AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72" VerticalScrollBarVisibility="Auto"/>
                </StackPanel>

                <!-- 第4行：备注（整行） -->
                <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,14,0,0">
                    <TextBlock Text="备注" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding Remark}" Style="{StaticResource TextField}"/>
                </StackPanel>
            </Grid>

            <TextBlock Text="{Binding Message}" Foreground="{StaticResource DangerBrush}"
                       FontSize="13" Margin="0,10,0,0"
                       Visibility="{Binding Message, Converter={StaticResource EmptyToVisibility}}"/>

            <Grid Margin="0,24,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="1" Content="取消" Style="{StaticResource SecondaryButton}" Width="92"
                        Click="Cancel_Click" IsCancel="True"/>
                <Button Grid.Column="3" Content="确定" Style="{StaticResource PrimaryButton}" Width="92"
                        Click="Ok_Click" IsDefault="True"/>
            </Grid>
        </StackPanel>
    </Border>
</Window>
