<Window x:Class="WinSystem.Views.MessageDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="消息详情" Width="640" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" FontFamily="{StaticResource DefaultFont}"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Border Background="White" CornerRadius="14" Padding="26" Margin="10"
            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="4" Opacity="0.20" Direction="270"/>
        </Border.Effect>
        <StackPanel>
            <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"
                       Foreground="{StaticResource TextPrimaryBrush}"/>
            <Rectangle Height="1" Margin="-12,14,-12,0" Fill="{StaticResource DividerBrush}"/>

            <!-- 元信息 -->
            <WrapPanel Margin="0,16,0,0">
                <Border Background="#F1F5FF" CornerRadius="6" Padding="10,4">
                    <TextBlock Text="{Binding TypeText}" FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryDarkBrush}"/>
                </Border>
                <Border Background="#EEF7EE" CornerRadius="6" Padding="10,4" Margin="8,0,0,0">
                    <TextBlock Text="{Binding StatusText}" FontSize="12" FontWeight="SemiBold"
                               Foreground="#2E7D32"/>
                </Border>
                <TextBlock Text="{Binding ScopeText}" FontSize="12.5" Margin="16,2,0,0"
                           Foreground="{StaticResource TextSecondaryBrush}"/>
                <TextBlock Text="发送人：" FontSize="12.5" Margin="24,2,0,0"
                           Foreground="{StaticResource TextMutedBrush}"/>
                <TextBlock Text="{Binding SenderText}" FontSize="12.5" Margin="4,2,0,0"
                           Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock Text="时间：" FontSize="12.5" Margin="24,2,0,0"
                           Foreground="{StaticResource TextMutedBrush}"/>
                <TextBlock Text="{Binding TimeText}" FontSize="12.5" Margin="4,2,0,0"
                           Foreground="{StaticResource TextPrimaryBrush}"/>
            </WrapPanel>

            <!-- 内容 -->
            <StackPanel Margin="0,16,0,0">
                <TextBlock Text="消息内容" Style="{StaticResource FieldLabel}"/>
                <Border Background="#FAFBFE" BorderBrush="{StaticResource DividerBrush}" BorderThickness="1"
                        CornerRadius="{StaticResource SmallRadius}" Padding="14">
                    <TextBlock Text="{Binding Content}" FontSize="13.5" LineHeight="24" TextWrapping="Wrap"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                </Border>
            </StackPanel>

            <!-- 备注 -->
            <StackPanel Margin="0,14,0,0" Visibility="{Binding HasRemark, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="备注" Style="{StaticResource FieldLabel}"/>
                <TextBlock Text="{Binding RemarkText}" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0,6,0,0"/>
            </StackPanel>

            <Grid Margin="0,24,0,0">
                <Button Content="关闭" Style="{StaticResource PrimaryButton}" Width="92" HorizontalAlignment="Right"
                        Click="Close_Click"/>
            </Grid>
        </StackPanel>
    </Border>
</Window>
