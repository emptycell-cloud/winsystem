<Window x:Class="WinSystem.Views.OperationLogDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="操作日志详情" Width="700" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" FontFamily="{StaticResource DefaultFont}"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Border Background="White" CornerRadius="14" Padding="26" Margin="10"
            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="4" Opacity="0.20" Direction="270"/>
        </Border.Effect>
        <StackPanel>
            <Grid>
                <StackPanel>
                    <TextBlock Text="操作日志详情" FontSize="20" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="{Binding CreatedText}" FontSize="12.5" Margin="0,6,0,0"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                </StackPanel>
                <WrapPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border Background="#F1F5FF" CornerRadius="6" Padding="10,4">
                        <TextBlock Text="{Binding Module}" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryDarkBrush}"/>
                    </Border>
                    <Border Margin="8,0,0,0" CornerRadius="6" Padding="10,4">
                        <Border.Style>
                            <Style TargetType="{x:Type Border}">
                                <Setter Property="Background" Value="#EEF7EE"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding StatusText}" Value="失败">
                                        <Setter Property="Background" Value="#FDECEC"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding StatusText}" FontSize="12" FontWeight="SemiBold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#2E7D32"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding StatusText}" Value="失败">
                                            <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                </WrapPanel>
            </Grid>
            <Rectangle Height="1" Margin="-12,14,-12,0" Fill="{StaticResource DividerBrush}"/>

            <ScrollViewer MaxHeight="440" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Margin="0,16,0,0">
                <StackPanel>
                    <!-- 基本信息 -->
                    <TextBlock Text="基本信息" Style="{StaticResource FieldLabel}"/>
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="操作人" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock Text="{Binding OperatorText}" FontSize="13" Margin="0,4,0,0"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="操作类型" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock Text="{Binding Action}" FontSize="13" Margin="0,4,0,0"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                        </StackPanel>
                    </Grid>
                    <StackPanel Margin="0,12,0,0">
                        <TextBlock Text="耗时" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBlock Text="{Binding DurationText}" FontSize="13" Margin="0,4,0,0"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                    </StackPanel>

                    <!-- 请求信息 -->
                    <TextBlock Text="请求信息" Style="{StaticResource FieldLabel}" Margin="0,16,0,0"/>
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="请求方法" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock Text="{Binding Method}" FontSize="13" Margin="0,4,0,0"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="请求路径" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock Text="{Binding Path}" FontSize="13" Margin="0,4,0,0" TextWrapping="Wrap"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                        </StackPanel>
                    </Grid>
                    <StackPanel Margin="0,12,0,0">
                        <TextBlock Text="User-Agent" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBlock Text="{Binding UserAgentText}" FontSize="12.5" Margin="0,4,0,0" TextWrapping="Wrap"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>

                    <!-- 操作详情 -->
                    <TextBlock Text="操作详情" Style="{StaticResource FieldLabel}" Margin="0,16,0,0"/>
                    <Border Background="#FAFBFE" BorderBrush="{StaticResource DividerBrush}" BorderThickness="1"
                            CornerRadius="{StaticResource SmallRadius}" Padding="14" Margin="0,8,0,0">
                        <TextBlock Text="{Binding DetailText}" FontSize="13" LineHeight="22" TextWrapping="Wrap"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                    </Border>

                    <!-- 操作前数据 -->
                    <TextBlock Text="操作前数据" Style="{StaticResource FieldLabel}" Margin="0,14,0,0"/>
                    <Border Background="#FAFBFE" BorderBrush="{StaticResource DividerBrush}" BorderThickness="1"
                            CornerRadius="{StaticResource SmallRadius}" Padding="14" Margin="0,8,0,0">
                        <TextBlock Text="{Binding BeforeDataText}" FontSize="12.5" LineHeight="20" TextWrapping="Wrap"
                                   FontFamily="Consolas" Foreground="{StaticResource TextPrimaryBrush}"/>
                    </Border>

                    <!-- 操作后数据 -->
                    <TextBlock Text="操作后数据" Style="{StaticResource FieldLabel}" Margin="0,14,0,0"/>
                    <Border Background="#FAFBFE" BorderBrush="{StaticResource DividerBrush}" BorderThickness="1"
                            CornerRadius="{StaticResource SmallRadius}" Padding="14" Margin="0,8,0,0">
                        <TextBlock Text="{Binding AfterDataText}" FontSize="12.5" LineHeight="20" TextWrapping="Wrap"
                                   FontFamily="Consolas" Foreground="{StaticResource TextPrimaryBrush}"/>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Grid Margin="0,20,0,0">
                <Button Content="关闭" Style="{StaticResource PrimaryButton}" Width="92" HorizontalAlignment="Right"
                        Click="Close_Click"/>
            </Grid>
        </StackPanel>
    </Border>
</Window>
