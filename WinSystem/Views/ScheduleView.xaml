<UserControl x:Class="WinSystem.Views.ScheduleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:WinSystem.Models">
    <UserControl.Resources>
        <!-- 行内操作按钮 -->
        <Style x:Key="RowActionButton" TargetType="{x:Type Button}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="{StaticResource SmallRadius}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#EAF0FB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RowDangerButton" TargetType="{x:Type Button}" BasedOn="{StaticResource RowActionButton}">
            <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Bd" Background="Transparent"
                                CornerRadius="{StaticResource SmallRadius}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FDECEC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 月历日期格子按钮 -->
        <Style x:Key="DayCellButton" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Padding" Value="6,5"/>
            <Setter Property="MinHeight" Value="84"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Top"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ClipToBounds" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource MediumRadius}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F0F4FF"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding IsCurrentMonth}" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#FAFBFC"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#EAF1FF"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 日历格子内的日程指示条 -->
        <DataTemplate x:Key="SchedulePill">
            <Border Background="#EDF2FF" CornerRadius="{StaticResource SmallRadius}" Padding="5,2"
                    Margin="0,2,0,0" HorizontalAlignment="Stretch">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="6" Height="6" Fill="{Binding Color, Converter={StaticResource HexToBrush}}"
                             VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBlock Text="{Binding Title}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- 右侧面板：当日日程明细项 -->
        <DataTemplate x:Key="DayDetailItem" DataType="{x:Type vm:SysSchedule}">
            <Border Padding="16,12" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <!-- 时间 -->
                    <Border Grid.Column="0" Background="#F1F4FB" CornerRadius="{StaticResource SmallRadius}"
                            Padding="8,4" VerticalAlignment="Top">
                        <TextBlock Text="{Binding TimeText}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </Border>
                    <!-- 内容 -->
                    <StackPanel Grid.Column="1" Margin="12,0,8,0">
                        <TextBlock Text="{Binding Title}" FontSize="13.5" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                            <TextBlock Text="{Binding StatusText}" FontSize="11"
                                       Foreground="{Binding StatusText, Converter={StaticResource StatusToBrush}}"/>
                            <TextBlock Text="·" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="6,0"/>
                            <TextBlock Text="{Binding Location}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </StackPanel>
                    <!-- 操作 -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                        <Button Content="编辑" Style="{StaticResource RowActionButton}"
                                Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                CommandParameter="{Binding}"/>
                        <Button Content="删除" Style="{StaticResource RowDangerButton}" Margin="4,0,0,0"
                                Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                CommandParameter="{Binding}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="26,22,26,26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <Grid Grid.Row="0">
            <StackPanel>
                <TextBlock Text="日程管理" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="按月历管理个人日程安排" Style="{StaticResource PageSubtitle}"/>
            </StackPanel>
            <Button Content="＋  新增日程" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right"
                    VerticalAlignment="Center" Command="{Binding AddCommand}"/>
        </Grid>

        <!-- 日历 + 当日明细 -->
        <Grid Grid.Row="1" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <!-- 左：月历 -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 月份导航 -->
                    <Border Grid.Row="0" Padding="16,12" BorderBrush="{StaticResource DividerBrush}"
                            BorderThickness="0,0,0,1">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="‹" Style="{StaticResource PageButton}" Command="{Binding PrevMonthCommand}" ToolTip="上一月"/>
                                <Button Content="›" Style="{StaticResource PageButton}" Margin="6,0,0,0" Command="{Binding NextMonthCommand}" ToolTip="下一月"/>
                                <Button Content="今天" Style="{StaticResource GhostButton}" Margin="10,0,0,0" Command="{Binding GoTodayCommand}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding MonthTitle}" FontSize="18" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- 星期表头 -->
                    <UniformGrid Grid.Row="1" Columns="7" Margin="12,12,12,4">
                        <TextBlock Text="周一" HorizontalAlignment="Center" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBlock Text="周二" HorizontalAlignment="Center" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBlock Text="周三" HorizontalAlignment="Center" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBlock Text="周四" HorizontalAlignment="Center" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBlock Text="周五" HorizontalAlignment="Center" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBlock Text="周六" HorizontalAlignment="Center" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBlock Text="周日" HorizontalAlignment="Center" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextMutedBrush}"/>
                    </UniformGrid>

                    <!-- 42 格月历 -->
                    <ItemsControl Grid.Row="2" ItemsSource="{Binding CalendarDays}" Margin="10,0,10,10">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="7"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.SelectDateCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                        CommandParameter="{Binding}" Style="{StaticResource DayCellButton}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- 日期数字（今天显示蓝色圆底） -->
                                        <Border Grid.Row="0" Width="26" Height="26" CornerRadius="13"
                                                HorizontalAlignment="Left" VerticalAlignment="Top">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding DayNumber}" FontSize="13" FontWeight="SemiBold"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsCurrentMonth}" Value="False">
                                                                <Setter Property="Foreground" Value="#C6CCD8"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                                <Setter Property="Foreground" Value="White"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>

                                        <!-- 农历日期 -->
                                        <TextBlock Grid.Row="0" Text="{Binding LunarText}" FontSize="10"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,3,0"/>

                                        <!-- 日程指示条 -->
                                        <ItemsControl Grid.Row="1" ItemsSource="{Binding VisibleSchedules}"
                                                      ItemTemplate="{StaticResource SchedulePill}" Margin="0,3,0,0"/>

                                        <!-- 更多折叠提示 -->
                                        <TextBlock Grid.Row="1" Text="{Binding MoreCount, StringFormat=+{0} 项更多}"
                                                   FontSize="10.5" Foreground="{StaticResource TextMutedBrush}"
                                                   HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="5,0,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasMore}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>

            <!-- 右：当日日程明细 -->
            <Border Grid.Column="1" Margin="16,0,0,0" Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 头部 -->
                    <Border Grid.Row="0" Padding="16,14" BorderBrush="{StaticResource DividerBrush}"
                            BorderThickness="0,0,0,1">
                        <StackPanel>
                            <TextBlock Text="当日日程" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="{Binding SelectedDateTitle}" FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- 明细列表 -->
                    <Grid Grid.Row="1">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding DaySchedules}"
                                          ItemTemplate="{StaticResource DayDetailItem}"/>
                        </ScrollViewer>

                        <!-- 空提示 -->
                        <TextBlock Text="当日暂无日程，点击右上角“新增日程”添加。" FontSize="13"
                                   Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" Margin="24,0" TextWrapping="Wrap" TextAlignment="Center"
                                   IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DaySchedules.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
