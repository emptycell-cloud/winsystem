<Window x:Class="WinSystem.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinSystem 综合管理系统" Width="1280" Height="800"
        MinWidth="1080" MinHeight="700"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        FontFamily="{StaticResource DefaultFont}"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <!-- 侧边导航项按钮 -->
        <Style x:Key="NavItemButton" TargetType="{x:Type Button}">
            <Setter Property="Foreground" Value="{StaticResource TextOnDarkBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Grid>
                            <Border x:Name="Accent" Width="4" Height="22" CornerRadius="0,3,3,0"
                                    Background="{StaticResource PrimaryLightBrush}"
                                    HorizontalAlignment="Left" VerticalAlignment="Center"
                                    Visibility="Collapsed"/>
                            <Border x:Name="Bd" Background="Transparent" CornerRadius="10"
                                    Padding="12,10">
                                <StackPanel Orientation="Horizontal">
                                    <Path x:Name="Icon" Data="{Binding IconData}" Fill="{StaticResource TextOnDarkBrush}"
                                          Width="20" Height="20" Stretch="Uniform" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="Txt" Text="{Binding Title}" Margin="12,0,0,0"
                                               VerticalAlignment="Center" FontWeight="Medium"
                                               Foreground="{StaticResource TextOnDarkBrush}"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#232D4D"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SidebarActiveBrush}"/>
                                <Setter TargetName="Icon" Property="Fill" Value="White"/>
                                <Setter TargetName="Txt" Property="Foreground" Value="White"/>
                                <Setter TargetName="Accent" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SidebarGroupTitle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="#7B87A6"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="16,0,0,8"/>
        </Style>

        <!-- 展开箭头 -->
        <Style x:Key="NavArrow" TargetType="{x:Type TextBlock}">
            <Setter Property="Text" Value="▸"/>
            <Setter Property="Foreground" Value="{StaticResource TextOnDarkBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                    <Setter Property="Text" Value="▾"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 二级菜单项按钮 -->
        <Style x:Key="SubNavItemButton" TargetType="{x:Type Button}">
            <Setter Property="Foreground" Value="#A8B2CC"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Grid>
                            <Border x:Name="Bd" Background="Transparent" CornerRadius="8"
                                    Padding="10,9" Margin="22,1,6,0">
                                <StackPanel Orientation="Horizontal">
                                    <Path x:Name="Icon" Data="{Binding IconData}" Fill="#8E99BC"
                                          Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="Txt" Text="{Binding Title}" FontWeight="Medium"
                                               Foreground="#A8B2CC" Margin="9,0,0,0" VerticalAlignment="Center"/>
                                    <!-- 未读气泡（如“我的消息”未读数） -->
                                    <Border x:Name="Badge" Background="#E5484D" CornerRadius="8"
                                            MinWidth="16" Height="16" Padding="5,0" Margin="8,0,0,0"
                                            VerticalAlignment="Center"
                                            Visibility="{Binding UnreadVisible, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="{Binding UnreadText}" FontSize="10" FontWeight="Bold"
                                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1B2547"/>
                                <Setter TargetName="Icon" Property="Fill" Value="#C6CEE2"/>
                                <Setter TargetName="Txt" Property="Foreground" Value="#C6CEE2"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SidebarActiveBrush}"/>
                                <Setter TargetName="Icon" Property="Fill" Value="White"/>
                                <Setter TargetName="Txt" Property="Foreground" Value="White"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 窗口顶部按钮 -->
        <Style x:Key="WindowCtrlButton" TargetType="{x:Type Button}">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverRowBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 关闭按钮（悬停红色） -->
        <Style x:Key="WindowCloseButton" TargetType="{x:Type Button}" BasedOn="{StaticResource WindowCtrlButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource DangerBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 工作区选项卡：标题按钮（透明，承载悬停，容器由外层 Border 提供） -->
        <Style x:Key="TabItemButton" TargetType="{x:Type Button}">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="9,9,0,0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter x:Name="Cp" VerticalAlignment="Center"
                                              TextElement.Foreground="{StaticResource TextSecondaryBrush}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                <Setter TargetName="Cp" Property="TextElement.Foreground"
                                        Value="{StaticResource TextPrimaryBrush}"/>
                                <Setter TargetName="Cp" Property="TextElement.FontWeight" Value="SemiBold"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 选项卡关闭按钮 -->
        <Style x:Key="TabCloseButton" TargetType="{x:Type Button}">
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="4">
                            <TextBlock Text="✕" FontSize="10" Foreground="{StaticResource TextMutedBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#D8DDE6"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource BaseBackgroundBrush}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ============ 侧边栏 ============ -->
        <Border Grid.Column="0" Background="{StaticResource SidebarGradientBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="64"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 品牌 -->
                <Grid Grid.Row="0" Margin="18,0">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="34" Height="34" CornerRadius="9" Background="#2AFFFFFF" VerticalAlignment="Center">
                            <Path Data="M12 2 2 7l10 5 10-5-10-5zm-2 8.5L4 13v6l6-3v-6zm4 0v6l6 3v-6l-6-3z"
                                  Fill="White" Width="20" Height="20" Stretch="Uniform"/>
                        </Border>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="WinSystem" Foreground="White" FontSize="17" FontWeight="Bold"/>
                            <TextBlock Text="综合管理系统" Foreground="{StaticResource TextOnDarkBrush}" FontSize="10.5" Opacity="0.7"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- 导航 -->
                <ScrollViewer Grid.Row="1" Margin="12,6,12,0" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding MenuItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,2,0,2">
                                    <!-- 一级菜单按钮 -->
                                    <Button Style="{StaticResource NavItemButton}"
                                            Command="{Binding DataContext.MenuCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}" Padding="12,10">
                                        <Button.Template>
                                            <ControlTemplate TargetType="{x:Type Button}">
                                                <Grid>
                                                    <Border x:Name="Accent" Width="4" Height="22" CornerRadius="0,3,3,0"
                                                            Background="{StaticResource PrimaryLightBrush}"
                                                            HorizontalAlignment="Left" VerticalAlignment="Center"
                                                            Visibility="Collapsed"/>
                                                    <Border x:Name="Bd" Background="Transparent" CornerRadius="10"
                                                            Padding="{TemplateBinding Padding}">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Orientation="Horizontal">
                                                                <Path x:Name="Icon" Data="{Binding IconData}" Fill="{StaticResource TextOnDarkBrush}"
                                                                      Width="20" Height="20" Stretch="Uniform" VerticalAlignment="Center"/>
                                                                <TextBlock x:Name="Txt" Text="{Binding Title}" Margin="12,0,0,0"
                                                                           VerticalAlignment="Center" FontWeight="Medium"
                                                                           Foreground="{StaticResource TextOnDarkBrush}"/>
                                                            </StackPanel>
                                                            <TextBlock Grid.Column="1" x:Name="Arrow" Style="{StaticResource NavArrow}"/>
                                                        </Grid>
                                                    </Border>
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="#232D4D"/>
                                                    </Trigger>
                                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="{StaticResource SidebarActiveBrush}"/>
                                                        <Setter TargetName="Icon" Property="Fill" Value="White"/>
                                                        <Setter TargetName="Txt" Property="Foreground" Value="White"/>
                                                        <Setter TargetName="Accent" Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding HasChildren}" Value="False">
                                                        <Setter TargetName="Arrow" Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>

                                    <!-- 二级子菜单 -->
                                    <ItemsControl ItemsSource="{Binding Children}"
                                                  Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibility}}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource SubNavItemButton}"
                                                        Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding PageKey}"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- 用户区 -->
                <Border Grid.Row="2" Margin="12,10,12,14" Padding="12,12" Background="#14FFFFFF" CornerRadius="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="34"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="40" Height="40" CornerRadius="20" Background="{StaticResource PrimaryGradientBrush}"
                                HorizontalAlignment="Left" VerticalAlignment="Center">
                            <TextBlock Text="{Binding CurrentUserName, Converter={StaticResource InitialConverter}}"
                                       Foreground="White" FontSize="16" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding CurrentUserName}" Foreground="White" FontWeight="SemiBold" FontSize="13"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding CurrentUserRole}" Foreground="{StaticResource TextOnDarkBrush}" FontSize="11"
                                       Opacity="0.7" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="2" Width="34" Height="34" Background="Transparent" BorderBrush="Transparent"
                                Cursor="Hand" Click="Logout_Click" ToolTip="退出登录" VerticalAlignment="Center">
                            <Button.Template>
                                <ControlTemplate TargetType="{x:Type Button}">
                                    <Border x:Name="Bd" Background="Transparent" CornerRadius="8">
                                        <Path Data="M17 7l-1.41 1.41L18.17 11H8v2h10.17l-2.58 2.58L17 17l5-5zM4 5h8V3H4c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h8v-2H4V5z"
                                              Fill="#9AA6C4" Width="18" Height="18" Stretch="Uniform"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#22FFFFFF"/>
                                            <Setter Property="Cursor" Value="Hand"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- ============ 内容区 ============ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="56"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 顶栏 -->
            <Border x:Name="TopBar" Grid.Row="0" Background="{StaticResource HeaderGradientBrush}"
                    BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TopBar_MouseLeftButtonDown">
                <Grid Margin="8,0,0,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                        <TextBlock Text="{Binding CurrentUserName}" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Text="/" Foreground="{StaticResource TextMutedBrush}" Margin="8,0"/>
                        <TextBlock Text="工作空间" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <!-- 未读消息铃铛 + 气泡 -->
                        <Button Style="{StaticResource WindowCtrlButton}" Command="{Binding OpenMyMessagesCommand}"
                                ToolTip="我的消息" Margin="0,0,2,0" VerticalAlignment="Center">
                            <Grid Width="20" Height="20">
                                <Path Data="M12,22 a2,2 0 0 0 2,-2 H10 a2,2 0 0 0 2,2 Z M18,16 V11 a6,6 0 0 0 -12,0 V16 l-2,3 H20 Z"
                                      Fill="#5A6478" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Border Background="#E5484D" CornerRadius="7" MinWidth="14" Height="14" Padding="3,0"
                                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-4,-8,0"
                                        Visibility="{Binding MyMessageUnreadVisible, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="{Binding MyMessageUnreadText}" FontSize="9" FontWeight="Bold"
                                               Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Button>
                        <TextBlock Text="{Binding Clock}" FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" Margin="10,0,14,0" FontFamily="Consolas"/>
                        <Button Style="{StaticResource WindowCtrlButton}" Click="Minimize_Click" ToolTip="最小化">
                            <Path Width="12" Height="12" Stretch="Uniform"
                                  Data="M5,12 H19" StrokeThickness="1.6" StrokeStartLineCap="Round"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"/>
                        </Button>
                        <Button x:Name="MaxBtn" Style="{StaticResource WindowCtrlButton}" Click="Maximize_Click" ToolTip="最大化">
                            <Path Width="12" Height="12" Stretch="Uniform"
                                  Data="M7,6.5 H17 A1.5,1.5 0 0 1 18.5,8 V16 A1.5,1.5 0 0 1 17,17.5 H7 A1.5,1.5 0 0 1 5.5,16 V8 A1.5,1.5 0 0 1 7,6.5 Z"
                                  StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"/>
                        </Button>
                        <Button Style="{StaticResource WindowCloseButton}" Click="Close_Click" ToolTip="关闭" Margin="0,0,6,0">
                            <Path Width="12" Height="12" Stretch="Uniform"
                                  Data="M7,7 L17,17 M17,7 L7,17"
                                  StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 选项卡栏 -->
            <Border Grid.Row="1" Background="#EEF1F6" BorderBrush="{StaticResource DividerBrush}"
                    BorderThickness="0,0,0,1">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Tabs}" Margin="10,6,10,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="TabContainer" Background="#F0F3F8"
                                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,1,1,0"
                                        CornerRadius="9,9,0,0" Margin="0,0,6,0" Padding="0,0,6,0">
                                    <Border.Style>
                                        <Style TargetType="{x:Type Border}">
                                            <Style.Triggers>
                                                <!-- 悬停：整个选项卡一起变浅 -->
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#E4E9F2"/>
                                                    <Setter Property="BorderBrush" Value="#C9D2E3"/>
                                                </Trigger>
                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                    <Setter Property="Background" Value="White"/>
                                                    <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <!-- 激活底部强调条（负右边距补偿容器内边距/边框，填满右边缘） -->
                                        <Border x:Name="ActiveBar" Grid.ColumnSpan="2" Height="3" CornerRadius="0"
                                                Background="{StaticResource PrimaryBrush}"
                                                VerticalAlignment="Bottom" Margin="0,0,-7,0">
                                            <Border.Style>
                                                <Style TargetType="{x:Type Border}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>
                                        <Button Grid.Column="0" Style="{StaticResource TabItemButton}"
                                                Content="{Binding Title}"
                                                Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding PageKey}"/>
                                        <Button Grid.Column="1" Style="{StaticResource TabCloseButton}"
                                                Margin="0,0,0,0" VerticalAlignment="Center"
                                                Visibility="{Binding CanClose, Converter={StaticResource BoolToVisibility}}"
                                                Command="{Binding CloseCommand}" ToolTip="关闭选项卡"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <!-- 页面内容 -->
            <ContentControl Grid.Row="2" Content="{Binding ActiveTab.Content}"/>
        </Grid>
    </Grid>
    </Border>
</Window>