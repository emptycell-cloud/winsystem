<Window x:Class="WinSystem.Views.RoleEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:WinSystem.ViewModels"
        Title="角色编辑" Width="720" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" FontFamily="{StaticResource DefaultFont}"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Border Background="White" CornerRadius="14" Padding="26" Margin="10"
            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="4" Opacity="0.20" Direction="270"/>
        </Border.Effect>
        <StackPanel>
            <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimaryBrush}"/>
            <Rectangle Height="1" Margin="-12,14,-12,0" Fill="{StaticResource DividerBrush}"/>

            <Grid Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 第1行：名称 / 编码 -->
                <StackPanel Grid.Row="0" Grid.Column="0">
                    <TextBlock Text="角色名称" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextField}"/>
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="2">
                    <TextBlock Text="角色编码" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextField}"
                             ToolTip="如 manager、operator"/>
                </StackPanel>

                <!-- 第2行：数据范围 / 状态 -->
                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,14,0,0">
                    <TextBlock Text="数据范围" Style="{StaticResource FieldLabel}"/>
                    <ComboBox ItemsSource="{x:Static vm:RoleEditorViewModel.DataScopeOptions}"
                              SelectedItem="{Binding DataScope}" Style="{StaticResource ComboBoxStyle}"
                              ItemContainerStyle="{StaticResource ComboBoxItemStyle}" MinHeight="36"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,14,0,0">
                    <TextBlock Text="状态" Style="{StaticResource FieldLabel}"/>
                    <ComboBox ItemsSource="{x:Static vm:RoleEditorViewModel.StatusOptions}"
                              SelectedItem="{Binding Status}" Style="{StaticResource ComboBoxStyle}"
                              ItemContainerStyle="{StaticResource ComboBoxItemStyle}" MinHeight="36"/>
                </StackPanel>

                <!-- 第3行：排序号 / 描述 -->
                <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,14,0,0">
                    <TextBlock Text="排序号" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding SortOrderText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextField}"/>
                </StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,14,0,0">
                    <TextBlock Text="描述" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding Description}" Style="{StaticResource TextField}"/>
                </StackPanel>

                <!-- 备注（整行） -->
                <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,14,0,0">
                    <TextBlock Text="备注" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding Remark}" Style="{StaticResource TextField}"/>
                </StackPanel>
            </Grid>

            <TextBlock Text="{Binding Message}" Foreground="{StaticResource DangerBrush}"
                       FontSize="13" Margin="0,10,0,0"
                       Visibility="{Binding Message, Converter={StaticResource EmptyToVisibility}}"/>

            <Grid Margin="0,24,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="1" Content="取消" Style="{StaticResource SecondaryButton}" Width="92" Click="Cancel_Click" IsCancel="True"/>
                <Button Grid.Column="3" Content="确定" Style="{StaticResource PrimaryButton}" Width="92" Click="Ok_Click" IsDefault="True"/>
            </Grid>
        </StackPanel>
    </Border>
</Window>