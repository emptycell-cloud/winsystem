<Window x:Class="WinSystem.Views.UserEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:WinSystem.ViewModels"
        xmlns:m="clr-namespace:WinSystem.Models"
        Title="用户编辑" Width="720" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" FontFamily="{StaticResource DefaultFont}"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <!-- 组织树节点模板 -->
        <HierarchicalDataTemplate DataType="{x:Type m:Organization}" ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal" Margin="2,2">
                <TextBlock Text="🗂" FontSize="12" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Name}" FontSize="13" Margin="6,0,0,0" VerticalAlignment="Center"
                           Foreground="{StaticResource TextPrimaryBrush}"/>
            </StackPanel>
        </HierarchicalDataTemplate>
    </Window.Resources>
    <Border Background="White" CornerRadius="14" Padding="26" Margin="10"
            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="4" Opacity="0.20" Direction="270"/>
        </Border.Effect>
        <StackPanel>
            <!-- 标题栏 -->
            <DockPanel>
                <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"/>
            </DockPanel>
            <Rectangle Height="1" Margin="-12,14,-12,0" Fill="{StaticResource DividerBrush}"/>

            <!-- 表单：两列布局 -->
            <Grid Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 第1行：姓名 / 登录名 -->
                <StackPanel Grid.Row="0" Grid.Column="0">
                    <TextBlock Text="姓名" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextField}"/>
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="2">
                    <TextBlock Text="登录名" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextField}"/>
                </StackPanel>

                <!-- 第2行：角色 -->
                <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,14,0,0">
                    <TextBlock Text="角色" Style="{StaticResource FieldLabel}"/>
                    <ComboBox ItemsSource="{Binding Roles}" SelectedItem="{Binding SelectedRole}"
                              Style="{StaticResource ComboBoxStyle}"
                              ItemContainerStyle="{StaticResource ComboBoxItemStyle}" MinHeight="36">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <!-- 第3行：职位 / 状态 -->
                <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,14,0,0">
                    <TextBlock Text="职位" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding Position, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextField}"/>
                </StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,14,0,0">
                    <TextBlock Text="状态" Style="{StaticResource FieldLabel}"/>
                    <ComboBox ItemsSource="{x:Static vm:UserEditorViewModel.StatusOptions}"
                              SelectedItem="{Binding Status}" Style="{StaticResource ComboBoxStyle}"
                              ItemContainerStyle="{StaticResource ComboBoxItemStyle}" MinHeight="36"/>
                </StackPanel>

                <!-- 第4行：所属组织（树形控件，整行） -->
                <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,14,0,0">
                    <TextBlock Text="所属组织" Style="{StaticResource FieldLabel}"/>
                    <Border Background="{StaticResource CardBackgroundBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            CornerRadius="{StaticResource SmallRadius}" Padding="4"
                            MaxHeight="180" Margin="0,0,0,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <TreeView x:Name="OrgTree" ItemsSource="{Binding Organizations}" SelectedItemChanged="OrgTree_SelectedItemChanged"
                                      Background="Transparent" BorderThickness="0"
                                      FontFamily="{StaticResource DefaultFont}"/>
                        </ScrollViewer>
                    </Border>
                </StackPanel>

                <!-- 第5行：邮箱 / 手机号 -->
                <StackPanel Grid.Row="4" Grid.Column="0" Margin="0,14,0,0">
                    <TextBlock Text="邮箱" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding Email}" Style="{StaticResource TextField}"/>
                </StackPanel>
                <StackPanel Grid.Row="4" Grid.Column="2" Margin="0,14,0,0">
                    <TextBlock Text="手机号" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding Phone}" Style="{StaticResource TextField}"/>
                </StackPanel>

                <!-- 第6行：备注（占整行） -->
                <StackPanel Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,14,0,0">
                    <TextBlock Text="备注" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding Remark}" Style="{StaticResource TextField}"/>
                </StackPanel>
            </Grid>

            <!-- 校验消息 -->
            <TextBlock Text="{Binding Message}" Foreground="{StaticResource DangerBrush}"
                       FontSize="13" Margin="0,10,0,0"
                       Visibility="{Binding Message, Converter={StaticResource EmptyToVisibility}}"/>

            <!-- 底部按钮 -->
            <Grid Margin="0,24,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="1" Content="取消" Style="{StaticResource SecondaryButton}" Width="92" Click="Cancel_Click" IsCancel="True"/>
                <Button Grid.Column="3" Content="确定" Style="{StaticResource PrimaryButton}" Width="92" Click="Ok_Click" IsDefault="True"/>
            </Grid>
        </StackPanel>
    </Border>
</Window>