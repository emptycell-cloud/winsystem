<Window x:Class="WinSystem.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinSystem - 登录" Width="880" Height="560"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" FontFamily="{StaticResource DefaultFont}"
        WindowStartupLocation="CenterScreen"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Border Margin="12" CornerRadius="18" ClipToBounds="True" Background="White">
        <Border.Effect>
            <DropShadowEffect BlurRadius="40" ShadowDepth="6" Opacity="0.25" Direction="270"/>
        </Border.Effect>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧品牌区 -->
            <Border Grid.Column="0" Background="{StaticResource PrimaryGradientBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="40,0">
                        <Border Width="64" Height="64" CornerRadius="16" Background="#33FFFFFF"
                                HorizontalAlignment="Left">
                            <Path Data="M12 2 2 7l10 5 10-5-10-5zm-2 8.5L4 13v6l6-3v-6zm4 0v6l6 3v-6l-6-3z"
                                  Fill="White" Width="34" Height="34" Stretch="Uniform"/>
                        </Border>
                        <TextBlock Text="WinSystem" FontSize="34" FontWeight="Bold" Foreground="White" Margin="0,22,0,0"/>
                        <TextBlock Text="综合管理系统" FontSize="16" Foreground="#E8EEFF" Margin="0,8,0,0"/>
                        <TextBlock Text="高效、安全、美观的一站式业务管理平台" FontSize="13" Foreground="#C3D0F2"
                                   TextWrapping="Wrap" Margin="0,24,0,0" LineHeight="22"/>
                    </StackPanel>
                    <TextBlock Grid.Row="1" Text="© 2026 WinSystem" FontSize="12" Foreground="#AEBADB"
                               Margin="40,0,0,26"/>
                </Grid>
            </Border>

            <!-- 右侧登录表单 -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="60,0">
                <TextBlock Text="欢迎回来" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock Text="请登录您的账号以继续" FontSize="14" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,8,0,0"/>

                <TextBlock Text="账号" Style="{StaticResource FieldLabel}" Margin="0,36,0,0"/>
                <TextBox x:Name="UsernameBox" Style="{StaticResource TextField}" FontSize="15"
                         Text="admin"/>
                <TextBlock Text="密码" Style="{StaticResource FieldLabel}" Margin="0,18,0,0"/>
                <PasswordBox x:Name="PasswordBox" Style="{StaticResource PasswordField}" FontSize="15"
                             Password="admin123"
                             KeyDown="PasswordBox_KeyDown"/>
                <Grid Margin="0,18,0,0">
                    <CheckBox x:Name="RememberBox" Content="记住我" Style="{StaticResource CheckBoxStyle}"/>
                    <TextBlock Text="admin / admin123" FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                               HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>

                <TextBlock x:Name="ErrorText" Foreground="{StaticResource DangerBrush}" FontSize="13"
                           Margin="0,14,0,0"/>

                <Button x:Name="LoginBtn" Content="登  录" FontSize="16" Style="{StaticResource PrimaryButton}" Height="46"
                        Margin="0,22,0,0" Click="Login_Click"/>
            </StackPanel>

            <!-- 右上角关闭按钮 -->
            <Button Grid.Column="1" Width="34" Height="34"
                    Content="X" FontSize="15" FontWeight="SemiBold" Cursor="Hand" Click="Close_Click"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,12,12,0"
                    Foreground="{StaticResource TextSecondaryBrush}" ToolTip="关闭">
                <Button.Template>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F0F2F7"/>
                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>
    </Border>
</Window>