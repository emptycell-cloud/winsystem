<Window x:Class="WinSystem.Views.MenuEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:WinSystem.ViewModels"
        xmlns:m="clr-namespace:WinSystem.Models"
        Title="菜单编辑" Width="720" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" FontFamily="{StaticResource DefaultFont}"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <!-- 上级菜单树节点模板 -->
        <HierarchicalDataTemplate DataType="{x:Type m:Menu}" ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal" Margin="2,2">
                <TextBlock Text="▸" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Name}" FontSize="13" Margin="5,0,0,0" VerticalAlignment="Center"
                           Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock Text="{Binding TypeText}" FontSize="10.5" Margin="6,0,0,0"
                           VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}"/>
            </StackPanel>
        </HierarchicalDataTemplate>
    </Window.Resources>
    <Border Background="White" CornerRadius="14" Padding="26" Margin="10"
            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="4" Opacity="0.20" Direction="270"/>
        </Border.Effect>
        <StackPanel>
            <!-- 标题栏 -->
            <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimaryBrush}"/>
            <Rectangle Height="1" Margin="-12,14,-12,0" Fill="{StaticResource DividerBrush}"/>

            <!-- 表单：两列布局 -->
            <Grid Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 第1行：名称 / 类型 -->
                <StackPanel Grid.Row="0" Grid.Column="0">
                    <TextBlock Text="菜单名称" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextField}"/>
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="2">
                    <TextBlock Text="菜单类型" Style="{StaticResource FieldLabel}"/>
                    <ComboBox ItemsSource="{x:Static vm:MenuEditorViewModel.TypeOptions}"
                              SelectedItem="{Binding Type}" Style="{StaticResource ComboBoxStyle}"
                              ItemContainerStyle="{StaticResource ComboBoxItemStyle}" MinHeight="36"/>
                </StackPanel>

                <!-- 第2行：上级菜单 / 路由地址 -->
                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,14,0,0">
                    <TextBlock Text="上级菜单" Style="{StaticResource FieldLabel}"/>
                    <Border Background="{StaticResource CardBackgroundBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            CornerRadius="{StaticResource SmallRadius}" Padding="4"
                            MaxHeight="180">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <TreeView x:Name="ParentMenuTree" ItemsSource="{Binding ParentTree}"
                                      SelectedItemChanged="ParentMenuTree_SelectedItemChanged"
                                      Background="Transparent" BorderThickness="0"
                                      FontFamily="{StaticResource DefaultFont}"/>
                        </ScrollViewer>
                    </Border>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,14,0,0">
                    <TextBlock Text="路由地址" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding Path}" Style="{StaticResource TextField}"
                             ToolTip="如 /users/list"/>
                </StackPanel>

                <!-- 第3行：组件路径 / 图标名称 -->
                <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,14,0,0">
                    <TextBlock Text="组件路径" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding Component}" Style="{StaticResource TextField}"/>
                </StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,14,0,0">
                    <TextBlock Text="图标名称" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding Icon}" Style="{StaticResource TextField}"
                             ToolTip="如 Users、Settings"/>
                </StackPanel>

                <!-- 第4行：排序号 / 是否显示 -->
                <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,14,0,0">
                    <TextBlock Text="排序号" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding SortOrderText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextField}"/>
                </StackPanel>
                <StackPanel Grid.Row="3" Grid.Column="2" Margin="0,14,0,0">
                    <TextBlock Text="是否显示" Style="{StaticResource FieldLabel}"/>
                    <ComboBox ItemsSource="{x:Static vm:MenuEditorViewModel.VisibleOptions}"
                              SelectedItem="{Binding Visible}" Style="{StaticResource ComboBoxStyle}"
                              ItemContainerStyle="{StaticResource ComboBoxItemStyle}" MinHeight="36"/>
                </StackPanel>

                <!-- 第5行：组件路径占位/权限标识 -->
                <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,14,0,0">
                    <TextBlock Text="权限标识" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding Permission}" Style="{StaticResource TextField}"
                             ToolTip="如 system:menus:add（权限按钮用）"/>
                </StackPanel>

                <!-- 第6行：备注（占整行） -->
                <StackPanel Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,14,0,0">
                    <TextBlock Text="备注" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding Remark}" Style="{StaticResource TextField}"/>
                </StackPanel>
            </Grid>

            <!-- 校验消息 -->
            <TextBlock Text="{Binding Message}" Foreground="{StaticResource DangerBrush}"
                       FontSize="13" Margin="0,10,0,0"
                       Visibility="{Binding Message, Converter={StaticResource EmptyToVisibility}}"/>

            <!-- 底部按钮 -->
            <Grid Margin="0,24,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="1" Content="取消" Style="{StaticResource SecondaryButton}" Width="92" Click="Cancel_Click" IsCancel="True"/>
                <Button Grid.Column="3" Content="确定" Style="{StaticResource PrimaryButton}" Width="92" Click="Ok_Click" IsDefault="True"/>
            </Grid>
        </StackPanel>
    </Border>
</Window>
