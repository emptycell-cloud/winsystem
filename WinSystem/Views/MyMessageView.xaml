<UserControl x:Class="WinSystem.Views.MyMessageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <DataTemplate x:Key="TypeTagTemplate">
            <Border Style="{StaticResource StatusTag}" Background="#EEF3FF">
                <TextBlock Text="{Binding TypeText}" FontSize="12" FontWeight="SemiBold"
                           Foreground="{StaticResource PrimaryDarkBrush}"/>
            </Border>
        </DataTemplate>

        <!-- 未读/已读状态：未读显示红点 + “未读”文字，已读显示灰点 + “已读” -->
        <DataTemplate x:Key="ReadStateTemplate">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Border Width="8" Height="8" CornerRadius="4" VerticalAlignment="Center" Margin="0,0,6,0">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#FF8C96"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsRead}" Value="True">
                                    <Setter Property="Background" Value="#C9CDD6"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>
                <TextBlock FontSize="12" FontWeight="SemiBold">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="未读"/>
                            <Setter Property="Foreground" Value="#E5484D"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsRead}" Value="True">
                                    <Setter Property="Text" Value="已读"/>
                                    <Setter Property="Foreground" Value="#8A8F99"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </DataTemplate>

        <Style x:Key="RowActionButton" TargetType="{x:Type Button}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="{StaticResource SmallRadius}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#EAF0FB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="26,22,26,26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <StackPanel>
                <TextBlock Text="我的消息" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="接收与查看发送给我的系统消息" Style="{StaticResource PageSubtitle}"/>
            </StackPanel>
            <Border HorizontalAlignment="Right" VerticalAlignment="Center"
                    Background="#FDECEC" CornerRadius="14" Padding="12,5">
                <TextBlock Text="{Binding UnreadText}" FontSize="12.5" FontWeight="SemiBold"
                           Foreground="#E5484D"/>
            </Border>
        </Grid>

        <Border Grid.Row="1" Margin="0,18,0,16" Padding="0" Background="Transparent" BorderThickness="0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <TextBlock Text="标题" FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}"
                           VerticalAlignment="Center"/>
                <TextBox Style="{StaticResource SearchBox}" Width="220" Margin="6,0,16,0"
                         Text="{Binding SearchTitle, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="类型" FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}"
                           VerticalAlignment="Center"/>
                <ComboBox Width="90" Margin="6,0,16,0" ItemsSource="{Binding TypeLabels}"
                          SelectedIndex="{Binding SearchType}" Style="{StaticResource ComboBoxStyle}"
                          ItemContainerStyle="{StaticResource ComboBoxItemStyle}" MinHeight="30"/>
                <Button Content="查询" Style="{StaticResource PrimaryButton}"
                        Command="{Binding SearchCommand}"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2">
            <Border Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DataGrid Grid.Row="0" ItemsSource="{Binding MyMessages}" SelectedItem="{Binding Selected}"
                              HorizontalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="状态" Width="80" CellTemplate="{StaticResource ReadStateTemplate}"/>
                            <DataGridTemplateColumn Header="标题" Width="2*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Title}" FontSize="13" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="FontWeight" Value="Normal"/>
                                                    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsRead}" Value="False">
                                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="类型" Width="80" CellTemplate="{StaticResource TypeTagTemplate}"/>
                            <DataGridTextColumn Header="发布范围" Binding="{Binding ScopeText}" Width="100"/>
                            <DataGridTextColumn Header="发送人" Binding="{Binding Sender}" Width="110"/>
                            <DataGridTextColumn Header="发布时间" Binding="{Binding CreatedText}" Width="150"/>
                            <DataGridTemplateColumn Header="操作" Width="170">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2">
                                            <Button Content="查看" Style="{StaticResource RowActionButton}"
                                                    Command="{Binding DataContext.ViewCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                                                    CommandParameter="{Binding}"/>
                                            <Button Content="标为已读" Margin="8,0,0,0"
                                                    Command="{Binding DataContext.MarkReadCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                                                    CommandParameter="{Binding}">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource RowActionButton}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsRead}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- 分页栏 -->
                    <Border Grid.Row="1" Background="#FAFBFE" BorderBrush="{StaticResource DividerBrush}"
                            BorderThickness="0,1,0,0" Padding="16,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="每页" FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}"
                                           VerticalAlignment="Center"/>
                                <ComboBox Width="70" Margin="6,0" SelectedItem="{Binding PageSize}"
                                          ItemsSource="{Binding PageSizeOptions}"
                                          Style="{StaticResource ComboBoxStyle}"
                                          ItemContainerStyle="{StaticResource ComboBoxItemStyle}" MinHeight="28"/>
                                <TextBlock Text="条" FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <TextBlock Grid.Column="1" Text="{Binding PageInfo}" FontSize="12.5"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="«" Style="{StaticResource PageButton}" Command="{Binding FirstPageCommand}" ToolTip="首页"/>
                                <Button Content="‹" Style="{StaticResource PageButton}" Margin="6,0,0,0" Command="{Binding PrevPageCommand}" ToolTip="上一页"/>
                                <TextBlock Text="{Binding PageIndex}" FontSize="13" FontWeight="SemiBold" Margin="12,0"
                                           Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="/" FontSize="12" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding TotalPages}" FontSize="13" Margin="6,0,12,0"
                                           Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                <Button Content="›" Style="{StaticResource PageButton}" Command="{Binding NextPageCommand}" ToolTip="下一页"/>
                                <Button Content="»" Style="{StaticResource PageButton}" Margin="6,0,0,0" Command="{Binding LastPageCommand}" ToolTip="末页"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- 加载动画层 -->
            <Border Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"
                    Background="#55FFFFFF" CornerRadius="{StaticResource LargeRadius}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ProgressBar IsIndeterminate="True" Width="160" Height="5"/>
                    <TextBlock Text="正在加载数据…" FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,14,0,0" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
