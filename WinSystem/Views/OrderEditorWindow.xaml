<Window x:Class="WinSystem.Views.OrderEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="订单编辑" Width="520" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" FontFamily="{StaticResource DefaultFont}"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Border Background="White" CornerRadius="14" Padding="26" Margin="10"
            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="4" Opacity="0.20" Direction="270"/>
        </Border.Effect>
        <StackPanel>
            <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimaryBrush}"/>
            <Rectangle Height="1" Margin="-12,14,-12,0" Fill="{StaticResource DividerBrush}"/>

            <StackPanel Margin="0,18,0,0">
                <TextBlock Text="订单编号" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding OrderNo}" Style="{StaticResource TextField}"
                         IsReadOnly="True" Foreground="{StaticResource TextSecondaryBrush}"/>
                <TextBlock Text="客户名称" Style="{StaticResource FieldLabel}" Margin="0,14,0,6"/>
                <TextBox Text="{Binding Customer, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextField}"/>
                <TextBlock Text="商品" Style="{StaticResource FieldLabel}" Margin="0,14,0,6"/>
                <ComboBox ItemsSource="{Binding ProductNames}" SelectedItem="{Binding ProductName}"
                          Style="{StaticResource ComboBoxStyle}" ItemContainerStyle="{StaticResource ComboBoxItemStyle}" MinHeight="36"/>
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="数量" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextField}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="单价（元）" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding Price, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextField}"/>
                    </StackPanel>
                </Grid>
                <TextBlock Text="订单状态" Style="{StaticResource FieldLabel}" Margin="0,14,0,6"/>
                <ComboBox ItemsSource="{Binding StatusOptions}" SelectedItem="{Binding Status}"
                          Style="{StaticResource ComboBoxStyle}" ItemContainerStyle="{StaticResource ComboBoxItemStyle}" MinHeight="36"/>
                <TextBlock Text="备注" Style="{StaticResource FieldLabel}" Margin="0,14,0,6"/>
                <TextBox Text="{Binding Remark}" Style="{StaticResource TextField}" Height="56"
                         AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top"/>
            </StackPanel>

            <TextBlock Text="{Binding Message}" Foreground="{StaticResource DangerBrush}"
                       FontSize="13" Margin="0,10,0,0"
                       Visibility="{Binding Message, Converter={StaticResource EmptyToVisibility}}"/>

            <Grid Margin="0,24,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="1" Content="取消" Style="{StaticResource SecondaryButton}" Width="92" Click="Cancel_Click" IsCancel="True"/>
                <Button Grid.Column="3" Content="确定" Style="{StaticResource PrimaryButton}" Width="92" Click="Ok_Click" IsDefault="True"/>
            </Grid>
        </StackPanel>
    </Border>
</Window>