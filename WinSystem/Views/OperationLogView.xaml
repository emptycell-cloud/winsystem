<UserControl x:Class="WinSystem.Views.OperationLogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <DataTemplate x:Key="StatusTagTemplate">
            <Border>
                <Border.Style>
                    <Style TargetType="{x:Type Border}" BasedOn="{StaticResource StatusTag}">
                        <Setter Property="Background" Value="#EEF7EE"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding StatusText}" Value="失败">
                                <Setter Property="Background" Value="#FDECEC"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding StatusText}" FontSize="12" FontWeight="SemiBold">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#2E7D32"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding StatusText}" Value="失败">
                                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Border>
        </DataTemplate>

        <Style x:Key="RowActionButton" TargetType="{x:Type Button}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="{StaticResource SmallRadius}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#EAF0FB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RowDangerButton" TargetType="{x:Type Button}" BasedOn="{StaticResource RowActionButton}">
            <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Bd" Background="Transparent"
                                CornerRadius="{StaticResource SmallRadius}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FDECEC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="26,22,26,26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <StackPanel>
                <TextBlock Text="操作日志" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="查看与管理系统操作日志" Style="{StaticResource PageSubtitle}"/>
            </StackPanel>
            <Button Content="清空日志" Style="{StaticResource DangerButton}" HorizontalAlignment="Right"
                    VerticalAlignment="Center" Command="{Binding ClearCommand}"/>
        </Grid>

        <Border Grid.Row="1" Margin="0,18,0,16" Padding="0" Background="Transparent" BorderThickness="0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <TextBlock Text="关键字" FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}"
                           VerticalAlignment="Center"/>
                <TextBox Style="{StaticResource SearchBox}" Width="180" Margin="6,0,16,0"
                         Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="操作类型" FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}"
                           VerticalAlignment="Center"/>
                <ComboBox Width="100" Margin="6,0,16,0" ItemsSource="{Binding ActionOptions}"
                          SelectedIndex="{Binding SearchAction}" Style="{StaticResource ComboBoxStyle}"
                          ItemContainerStyle="{StaticResource ComboBoxItemStyle}" MinHeight="30"/>
                <TextBlock Text="状态" FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}"
                           VerticalAlignment="Center"/>
                <ComboBox Width="90" Margin="6,0,16,0" ItemsSource="{Binding StatusOptions}"
                          SelectedIndex="{Binding SearchStatus}" Style="{StaticResource ComboBoxStyle}"
                          ItemContainerStyle="{StaticResource ComboBoxItemStyle}" MinHeight="30"/>
                <Button Content="查询" Style="{StaticResource PrimaryButton}"
                        Command="{Binding SearchCommand}"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2">
            <Border Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DataGrid Grid.Row="0" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}"
                              HorizontalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="行号" Binding="{Binding Index}" Width="60"/>
                            <DataGridTextColumn Header="操作时间" Binding="{Binding CreatedText}" Width="190"/>
                            <DataGridTextColumn Header="操作人" Binding="{Binding OperatorText}" Width="180"/>
                            <DataGridTextColumn Header="模块" Binding="{Binding Module}" Width="130"/>
                            <DataGridTextColumn Header="操作" Binding="{Binding Action}" Width="110"/>
                            <DataGridTemplateColumn Header="状态" Width="110" CellTemplate="{StaticResource StatusTagTemplate}"/>
                            <DataGridTextColumn Header="耗时" Binding="{Binding DurationText}" Width="100"/>
                            <DataGridTextColumn Header="请求路径" Binding="{Binding Path}" Width="2*"/>
                            <DataGridTemplateColumn Header="操作" Width="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2">
                                            <Button Content="查看" Style="{StaticResource RowActionButton}"
                                                    Command="{Binding DataContext.ViewCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                                                    CommandParameter="{Binding}"/>
                                            <Button Content="删除" Style="{StaticResource RowDangerButton}" Margin="8,0,0,0"
                                                    Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                                                    CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- 分页栏 -->
                    <Border Grid.Row="1" Background="#FAFBFE" BorderBrush="{StaticResource DividerBrush}"
                            BorderThickness="0,1,0,0" Padding="16,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="每页" FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}"
                                           VerticalAlignment="Center"/>
                                <ComboBox Width="70" Margin="6,0" SelectedItem="{Binding PageSize}"
                                          ItemsSource="{Binding PageSizeOptions}"
                                          Style="{StaticResource ComboBoxStyle}"
                                          ItemContainerStyle="{StaticResource ComboBoxItemStyle}" MinHeight="28"/>
                                <TextBlock Text="条" FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <TextBlock Grid.Column="1" Text="{Binding PageInfo}" FontSize="12.5"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="«" Style="{StaticResource PageButton}" Command="{Binding FirstPageCommand}" ToolTip="首页"/>
                                <Button Content="‹" Style="{StaticResource PageButton}" Margin="6,0,0,0" Command="{Binding PrevPageCommand}" ToolTip="上一页"/>
                                <TextBlock Text="{Binding PageIndex}" FontSize="13" FontWeight="SemiBold" Margin="12,0"
                                           Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="/" FontSize="12" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding TotalPages}" FontSize="13" Margin="6,0,12,0"
                                           Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                <Button Content="›" Style="{StaticResource PageButton}" Command="{Binding NextPageCommand}" ToolTip="下一页"/>
                                <Button Content="»" Style="{StaticResource PageButton}" Margin="6,0,0,0" Command="{Binding LastPageCommand}" ToolTip="末页"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- 加载动画层 -->
            <Border Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"
                    Background="#55FFFFFF" CornerRadius="{StaticResource LargeRadius}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ProgressBar IsIndeterminate="True" Width="160" Height="5"/>
                    <TextBlock Text="正在加载数据…" FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,14,0,0" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
