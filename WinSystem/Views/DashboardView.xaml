<UserControl x:Class="WinSystem.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:WinSystem.Views">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="26,22,26,30">

            <!-- 欢迎横幅 -->
            <Border CornerRadius="16" Padding="26,22" Background="{StaticResource PrimaryGradientBrush}">
                <Grid>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Greeting}" FontSize="26" FontWeight="SemiBold"
                                   Foreground="White"/>
                        <TextBlock Text="{Binding GreetingSub}" FontSize="14" Foreground="#EAF0FF"
                                   Margin="0,8,0,0"/>
                    </StackPanel>
                    <TextBlock Text="{Binding Clock, Mode=OneWay}" Foreground="White" FontSize="15"
                               HorizontalAlignment="Right" VerticalAlignment="Top" FontFamily="Consolas" Opacity="0.9"/>
                </Grid>
            </Border>

            <!-- 统计卡片 -->
            <ItemsControl ItemsSource="{Binding StatCards}" Margin="0,20,0,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="4"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="0,0,16,0" Padding="18" Height="106">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="46"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <!-- 图标 -->
                                <Border Grid.Row="0" Grid.RowSpan="3" Width="42" Height="42" CornerRadius="10"
                                        Background="{Binding PanelBrush, Converter={StaticResource NamedBrush}}"
                                        HorizontalAlignment="Left" VerticalAlignment="Top">
                                    <Path Data="{Binding IconData}" Fill="{Binding IconBrush, Converter={StaticResource NamedBrush}}"
                                          Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Title}"
                                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="13"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Value}"
                                           FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"
                                           Margin="0,2,0,0"/>
                                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                                    <TextBlock Text="{Binding DeltaIcon}" Foreground="{Binding DeltaBrush, Converter={StaticResource NamedBrush}}"
                                               FontWeight="Bold" FontSize="12" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding DeltaText}" Foreground="{Binding DeltaBrush, Converter={StaticResource NamedBrush}}"
                                               FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- 图表行 -->
            <Grid Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 月度营收柱状图 -->
                <Border Grid.Column="0" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="近 6 个月营收（已完成订单）" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="单位：元" Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,4,0,0"/>
                        <Grid Height="190" Margin="0,16,0,0">
                            <!-- 基线 -->
                            <Rectangle Fill="{StaticResource DividerBrush}" Height="1" VerticalAlignment="Bottom" Margin="0,0,0,22"/>
                            <ItemsControl ItemsSource="{Binding MonthlyBars}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="6"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Bottom">
                                            <TextBlock Text="{Binding Display}" FontSize="11" HorizontalAlignment="Center"
                                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,5"/>
                                            <Rectangle Width="26" Height="{Binding Height}" RadiusX="5" RadiusY="5"
                                                       Fill="{Binding Brush, Converter={StaticResource NamedBrush}}"
                                                       HorizontalAlignment="Center"/>
                                            <TextBlock Text="{Binding Label}" FontSize="12" HorizontalAlignment="Center"
                                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,8,0,0"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 品类占比 -->
                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="在售商品品类分布" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="按商品数量占比" Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,4,0,0"/>
                        <ItemsControl ItemsSource="{Binding CategoryBars}" Margin="0,18,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,16">
                                        <Grid>
                                            <TextBlock Text="{Binding Name}" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <TextBlock FontSize="13" HorizontalAlignment="Right"
                                                       Foreground="{StaticResource TextSecondaryBrush}">
                                            <Run Text="{Binding Percent}"/><Run Text="%"/>
                                        </TextBlock>
                                        </Grid>
                                        <Border Background="#EEF1F7" Height="8" CornerRadius="4" Margin="0,7,0,0">
                                            <Border Width="{Binding Percent, Converter={StaticResource PercentToWidth}, ConverterParameter=190}"
                                                    Height="8" CornerRadius="4"
                                                    Background="{Binding Brush, Converter={StaticResource NamedBrush}}"
                                                    HorizontalAlignment="Left"/>
                                        </Border>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 最新订单 -->
            <Border Style="{StaticResource Card}" Margin="0,20,0,0">
                <StackPanel>
                    <TextBlock Text="最新订单" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="最近创建的 6 条订单记录" Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,4,0,0"/>
                    <DataGrid ItemsSource="{Binding RecentOrders}" Margin="0,14,0,0" Height="260">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="订单编号" Binding="{Binding OrderNo}" Width="*"/>
                            <DataGridTextColumn Header="客户" Binding="{Binding Customer}" Width="110"/>
                            <DataGridTextColumn Header="商品" Binding="{Binding ProductName}" Width="*"/>
                            <DataGridTextColumn Header="金额" Binding="{Binding Amount, Converter={StaticResource Currency}}" Width="110"/>
                            <DataGridTemplateColumn Header="状态" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border x:Name="Tag" Style="{StaticResource StatusTag}"
                                                Background="{Binding Status, Converter={StaticResource StatusToTag}, ConverterParameter=background}">
                                            <TextBlock Text="{Binding Status}" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{Binding Status, Converter={StaticResource StatusToTag}}"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="时间" Binding="{Binding CreatedAt, StringFormat=MM-dd HH:mm}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>