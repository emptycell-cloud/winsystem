<UserControl x:Class="WinSystem.Views.ConfigView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="RowActionButton" TargetType="{x:Type Button}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="{StaticResource SmallRadius}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#EAF0FB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RowDangerButton" TargetType="{x:Type Button}" BasedOn="{StaticResource RowActionButton}">
            <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Bd" Background="Transparent"
                                CornerRadius="{StaticResource SmallRadius}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FDECEC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="26,22,26,26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <Grid Grid.Row="0">
            <StackPanel>
                <TextBlock Text="系统参数" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="管理系统参数配置" Style="{StaticResource PageSubtitle}"/>
            </StackPanel>
            <Button Content="＋  新增参数" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right"
                    VerticalAlignment="Center" Command="{Binding AddCommand}"/>
        </Grid>

        <!-- 查询 -->
        <Border Grid.Row="1" Margin="0,18,0,16" Padding="0" Background="Transparent" BorderThickness="0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <TextBlock Text="参数名称/键" FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}"
                           VerticalAlignment="Center"/>
                <TextBox Style="{StaticResource SearchBox}" Width="200" Margin="6,0,16,0"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                <Button Content="查询" Style="{StaticResource PrimaryButton}" Command="{Binding SearchCommand}"/>
            </StackPanel>
        </Border>

        <!-- 列表 -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="18,16,18,10">
                    <TextBlock Text="参数列表" FontSize="14" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="{Binding TotalCount, StringFormat=共 {0} 项}" FontSize="12"
                               Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Right"
                               VerticalAlignment="Center"/>
                </Grid>
                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                    <DataGrid ItemsSource="{Binding Items}" AutoGenerateColumns="False" HorizontalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="参数名称" Binding="{Binding ConfigName}" Width="160"/>
                            <DataGridTextColumn Header="参数键" Binding="{Binding ConfigKey}" Width="200"/>
                            <DataGridTextColumn Header="参数值" Binding="{Binding ConfigValue}" Width="*"/>
                            <DataGridTextColumn Header="类型" Binding="{Binding TypeText}" Width="140"/>
                            <DataGridTextColumn Header="来源" Binding="{Binding SystemText}" Width="160"/>
                            <DataGridTextColumn Header="备注" Binding="{Binding Remark}" Width="*"/>
                            <DataGridTemplateColumn Header="操作" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2">
                                            <Button Content="编辑" Style="{StaticResource RowActionButton}"
                                                    Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                                                    CommandParameter="{Binding}"/>
                                            <Button Content="删除" Style="{StaticResource RowDangerButton}" Margin="6,0,0,0"
                                                    Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                                                    CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- 空提示 -->
                    <TextBlock Text="暂无系统参数，点击右上角“新增参数”添加。" FontSize="13"
                               Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center"
                               VerticalAlignment="Center" IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Items.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    </Grid>

                    <!-- 分页栏 -->
                    <Border Grid.Row="1" Background="#FAFBFE" BorderBrush="{StaticResource DividerBrush}"
                            BorderThickness="0,1,0,0" Padding="16,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- 每页条数 -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="每页" FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}"
                                           VerticalAlignment="Center"/>
                                <ComboBox Width="70" Margin="6,0" SelectedItem="{Binding PageSize}"
                                          ItemsSource="{Binding PageSizeOptions}"
                                          Style="{StaticResource ComboBoxStyle}"
                                          ItemContainerStyle="{StaticResource ComboBoxItemStyle}" MinHeight="28"/>
                                <TextBlock Text="条" FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- 分页信息 -->
                            <TextBlock Grid.Column="1" Text="{Binding PageInfo}" FontSize="12.5"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>

                            <!-- 分页按钮 -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="«" Style="{StaticResource PageButton}" Command="{Binding FirstPageCommand}" ToolTip="首页"/>
                                <Button Content="‹" Style="{StaticResource PageButton}" Margin="6,0,0,0" Command="{Binding PrevPageCommand}" ToolTip="上一页"/>
                                <TextBlock Text="{Binding PageIndex}" FontSize="13" FontWeight="SemiBold" Margin="12,0"
                                           Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="/" FontSize="12" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding TotalPages}" FontSize="13" Margin="6,0,12,0"
                                           Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                <Button Content="›" Style="{StaticResource PageButton}" Command="{Binding NextPageCommand}" ToolTip="下一页"/>
                                <Button Content="»" Style="{StaticResource PageButton}" Margin="6,0,0,0" Command="{Binding LastPageCommand}" ToolTip="末页"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
