<UserControl x:Class="WinSystem.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="26,22,26,30">
            <TextBlock Text="系统设置" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="个人资料、安全口令与关于信息" Style="{StaticResource PageSubtitle}"/>

            <!-- 个人资料 -->
            <Border Style="{StaticResource Card}" Margin="0,20,0,0">
                <StackPanel Width="480" HorizontalAlignment="Left">
                    <TextBlock Text="个人资料" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="更新你的基础信息" Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,4,0,16"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="姓名" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Name}" Style="{StaticResource TextField}" Margin="0,0,0,12"/>
                        <TextBlock Grid.Row="1" Text="登录名" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Username, Mode=OneWay}" Style="{StaticResource TextField}"
                                 IsReadOnly="True" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,12"/>
                        <TextBlock Grid.Row="2" Text="邮箱" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Email}" Style="{StaticResource TextField}" Margin="0,0,0,12"/>
                        <TextBlock Grid.Row="3" Text="手机号" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Phone}" Style="{StaticResource TextField}" Margin="0,0,0,4"/>
                    </Grid>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                        <Button Content="保存资料" Style="{StaticResource PrimaryButton}" Command="{Binding SaveProfileCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 修改密码 -->
            <Border Style="{StaticResource Card}" Margin="0,20,0,0">
                <StackPanel Width="480" HorizontalAlignment="Left">
                    <TextBlock Text="修改密码" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="定期更换口令有助于提升账户安全" Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,4,0,16"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="当前密码" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding OldPwd, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource TextField}" Margin="0,0,0,12"/>
                        <TextBlock Grid.Row="1" Text="新密码" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding NewPwd, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource TextField}" Margin="0,0,0,12"/>
                        <TextBlock Grid.Row="2" Text="确认新密码" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding ConfirmPwd, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource TextField}"/>
                    </Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                        <Button Content="修改密码" Style="{StaticResource PrimaryButton}" Command="{Binding ChangePasswordCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 关于 -->
            <Border Style="{StaticResource Card}" Margin="0,20,0,0">
                <StackPanel>
                    <TextBlock Text="关于系统" Style="{StaticResource SectionTitle}"/>
                    <StackPanel HorizontalAlignment="Right">
                        <TextBlock Text="当前登录" FontSize="12" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Right"/>
                        <TextBlock Text="{Binding Position}" FontSize="14" FontWeight="SemiBold" Margin="0,3,0,0" HorizontalAlignment="Right"/>
                    </StackPanel>
                    <TextBlock Text="WinSystem 综合管理系统" FontSize="16" FontWeight="SemiBold" Margin="0,16,0,0"/>
                    <TextBlock Text="{Binding AppVersion}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,0"/>
                    <TextBlock Text="一款现代化、美观易用的桌面综合管理应用，采用 .NET WPF 构建。" FontSize="13"
                               Foreground="{StaticResource TextMutedBrush}" Margin="0,12,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>