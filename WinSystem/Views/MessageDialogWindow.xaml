<Window x:Class="WinSystem.Views.MessageDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="提示" Width="420" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" FontFamily="{StaticResource DefaultFont}"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Border Background="White" CornerRadius="16" Padding="24,20" Margin="12"
            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="32" ShadowDepth="5" Opacity="0.18" Direction="270"/>
        </Border.Effect>

        <Border.Triggers>
            <EventTrigger RoutedEvent="Window.Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1"
                                         Duration="0:0:0.18"/>
                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                         From="0.92" To="1" Duration="0:0:0.18">
                            <DoubleAnimation.EasingFunction>
                                <BackEase EasingMode="EaseOut" Amplitude="0.25"/>
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Border.Triggers>
        <Border.RenderTransform>
            <ScaleTransform/>
        </Border.RenderTransform>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 顶栏：图标 + 标题 + 关闭 -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border x:Name="IconHost" Width="44" Height="44" CornerRadius="22" VerticalAlignment="Top">
                    <Path x:Name="IconPath" Width="22" Height="22" Stretch="Uniform"
                          Stroke="White" StrokeThickness="2.4"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                </Border>

                <TextBlock Grid.Column="1" x:Name="TitleText" FontSize="18" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           VerticalAlignment="Center" Margin="16,0,0,0"/>

                <Button Grid.Column="2" Width="30" Height="30" Content="✕" FontSize="13"
                        Cursor="Hand" Click="Close_Click" VerticalAlignment="Top"
                        Foreground="{StaticResource TextMutedBrush}" ToolTip="关闭">
                    <Button.Template>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Border x:Name="Bd" Background="Transparent" CornerRadius="8">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#F0F2F7"/>
                                    <Setter Property="Foreground" Value="#37435C"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <!-- 消息正文 -->
            <ScrollViewer Grid.Row="1" MaxHeight="220" VerticalScrollBarVisibility="Auto"
                          Margin="0,18,0,0">
                <TextBlock x:Name="MessageText" FontSize="14"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           TextWrapping="Wrap"
                           LineHeight="23" LineStackingStrategy="BlockLineHeight"/>
            </ScrollViewer>

            <!-- 底部按钮 -->
            <Grid Grid.Row="2" Margin="0,26,0,0" HorizontalAlignment="Right">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="CancelBtn" Grid.Column="0" Content="取消" Style="{StaticResource SecondaryButton}"
                        Width="88" Margin="0,0,10,0" Click="Cancel_Click" IsCancel="True" Visibility="Collapsed"/>
                <Button x:Name="OkBtn" Grid.Column="1" Content="确定" Style="{StaticResource PrimaryButton}"
                        Width="88" Click="Ok_Click" IsDefault="True"/>
            </Grid>
        </Grid>
    </Border>
</Window>