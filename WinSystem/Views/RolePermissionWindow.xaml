<Window x:Class="WinSystem.Views.RolePermissionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:WinSystem.ViewModels"
        Title="分配权限" Width="520" MinHeight="520" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" FontFamily="{StaticResource DefaultFont}"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <Style x:Key="PermCheck" TargetType="{x:Type CheckBox}">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,3"/>
        </Style>
        <HierarchicalDataTemplate DataType="{x:Type vm:RoleMenuNode}" ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal">
                <CheckBox Style="{StaticResource PermCheck}" Content="{Binding Name}"
                          IsChecked="{Binding IsChecked}" VerticalAlignment="Center"/>
                <TextBlock Text="›" FontSize="10" Margin="6,0,0,0" Foreground="{StaticResource TextMutedBrush}"
                           ToolTip="目录/页面"/>
            </StackPanel>
        </HierarchicalDataTemplate>
    </Window.Resources>
    <Border Background="White" CornerRadius="14" Padding="24" Margin="10"
            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="4" Opacity="0.20" Direction="270"/>
        </Border.Effect>
        <StackPanel>
            <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
            <Rectangle Height="1" Margin="-10,14,-10,0" Fill="{StaticResource DividerBrush}"/>

            <Border Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="{StaticResource SmallRadius}" Padding="10"
                    Margin="0,16,0,0" MaxHeight="400">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <TreeView ItemsSource="{Binding ParentTree}" Background="Transparent" BorderThickness="0"
                              FontFamily="{StaticResource DefaultFont}"/>
                </ScrollViewer>
            </Border>

            <TextBlock Text="勾选该角色可访问的菜单权限" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,10,0,0"/>

            <Grid Margin="0,22,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="1" Content="取消" Style="{StaticResource SecondaryButton}" Width="92" Click="Cancel_Click" IsCancel="True"/>
                <Button Grid.Column="3" Content="保存" Style="{StaticResource PrimaryButton}" Width="92" Click="Ok_Click" IsDefault="True"/>
            </Grid>
        </StackPanel>
    </Border>
</Window>