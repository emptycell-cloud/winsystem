<UserControl x:Class="WinSystem.Controls.TimePicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="OnLoaded">
    <StackPanel Orientation="Horizontal">
        <CheckBox x:Name="AllDayCheck" Content="全天" FontSize="13.5"
                  Foreground="{StaticResource TextSecondaryBrush}"
                  VerticalAlignment="Center" Margin="0,0,12,0"
                  Checked="OnAllDayToggled" Unchecked="OnAllDayToggled"/>
        <StackPanel x:Name="TimeRow" Orientation="Horizontal">
            <ComboBox x:Name="HourCombo"
                      Style="{StaticResource ComboBoxStyle}"
                      ItemContainerStyle="{StaticResource ComboBoxItemStyle}"
                      Width="72" MinHeight="36" SelectionChanged="OnHourChanged"/>
            <TextBlock Text=":" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"
                       Foreground="{StaticResource TextPrimaryBrush}" Margin="6,0"/>
            <ComboBox x:Name="MinuteCombo"
                      Style="{StaticResource ComboBoxStyle}"
                      ItemContainerStyle="{StaticResource ComboBoxItemStyle}"
                      Width="72" MinHeight="36" SelectionChanged="OnMinuteChanged"/>
        </StackPanel>
    </StackPanel>
</UserControl>
