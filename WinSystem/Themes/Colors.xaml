<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ========== 品牌主色 ========== -->
    <Color x:Key="PrimaryColor">#4F7CFF</Color>
    <Color x:Key="PrimaryDarkColor">#3D63CC</Color>
    <Color x:Key="PrimaryLightColor">#6E94FF</Color>

    <!-- ========== 语义色 ========== -->
    <Color x:Key="SuccessColor">#22C55E</Color>
    <Color x:Key="WarningColor">#F59E0B</Color>
    <Color x:Key="DangerColor">#EF4444</Color>
    <Color x:Key="InfoColor">#06B6D4</Color>

    <!-- ========== 中性色 ========== -->
    <Color x:Key="SidebarColor">#1C2540</Color>
    <Color x:Key="SidebarLightColor">#273250</Color>
    <Color x:Key="SidebarActiveColor">#2E3B5E</Color>
    <Color x:Key="BaseBackgroundColor">#F3F5FA</Color>
    <Color x:Key="CardBackgroundColor">#FFFFFF</Color>
    <Color x:Key="BorderColor">#E4E8F0</Color>
    <Color x:Key="DividerColor">#EEF1F7</Color>
    <Color x:Key="TextPrimaryColor">#1F2937</Color>
    <Color x:Key="TextSecondaryColor">#6B7280</Color>
    <Color x:Key="TextMutedColor">#9CA3AF</Color>
    <Color x:Key="TextOnDarkColor">#E6EAF2</Color>

    <!-- ========== 悬停/按下 ========== -->
    <Color x:Key="HoverRowColor">#EEF3FF</Color>
    <Color x:Key="PressColor">#E2E9FF</Color>

    <!-- ========== 数据面板颜色 ========== -->
    <Color x:Key="PanelBlueColor">#DBE7FF</Color>
    <Color x:Key="PanelGreenColor">#DBF5E5</Color>
    <Color x:Key="PanelOrangeColor">#FDEFD9</Color>
    <Color x:Key="PanelRedColor">#FCE3E3</Color>

    <!-- ========== 实心画刷 ========== -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}"/>
    <SolidColorBrush x:Key="PrimaryDarkBrush" Color="{StaticResource PrimaryDarkColor}"/>
    <SolidColorBrush x:Key="PrimaryLightBrush" Color="{StaticResource PrimaryLightColor}"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}"/>
    <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource InfoColor}"/>

    <SolidColorBrush x:Key="SidebarBrush" Color="{StaticResource SidebarColor}"/>
    <SolidColorBrush x:Key="SidebarLightBrush" Color="{StaticResource SidebarLightColor}"/>
    <SolidColorBrush x:Key="SidebarActiveBrush" Color="{StaticResource SidebarActiveColor}"/>
    <SolidColorBrush x:Key="BaseBackgroundBrush" Color="{StaticResource BaseBackgroundColor}"/>
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="{StaticResource CardBackgroundColor}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="DividerBrush" Color="{StaticResource DividerColor}"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}"/>
    <SolidColorBrush x:Key="TextOnDarkBrush" Color="{StaticResource TextOnDarkColor}"/>
    <SolidColorBrush x:Key="HoverRowBrush" Color="{StaticResource HoverRowColor}"/>
    <SolidColorBrush x:Key="PressBrush" Color="{StaticResource PressColor}"/>
    <SolidColorBrush x:Key="PanelBlueBrush" Color="{StaticResource PanelBlueColor}"/>
    <SolidColorBrush x:Key="PanelGreenBrush" Color="{StaticResource PanelGreenColor}"/>
    <SolidColorBrush x:Key="PanelOrangeBrush" Color="{StaticResource PanelOrangeColor}"/>
    <SolidColorBrush x:Key="PanelRedBrush" Color="{StaticResource PanelRedColor}"/>

    <!-- ========== 渐变色画刷 ========== -->
    <LinearGradientBrush x:Key="PrimaryGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#5B8CFF" Offset="0"/>
        <GradientStop Color="#6E5BFF" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="SidebarGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#1C2540" Offset="0"/>
        <GradientStop Color="#232F50" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="HeaderGradientBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#FFFFFF" Offset="0"/>
        <GradientStop Color="#F7F9FF" Offset="1"/>
    </LinearGradientBrush>

</ResourceDictionary>